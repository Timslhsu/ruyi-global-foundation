---
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
  {
    steps.map((s, i) => (
      <li class="card">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-ruyi-700 font-bold text-white">{i + 1}</span>
        <h3 class="mt-3 font-semibold text-ruyi-900">{s.title}</h3>
        <p class="mt-1 text-sm text-ink/80">{s.text}</p>
      </li>
    ))
  }
</ol>
