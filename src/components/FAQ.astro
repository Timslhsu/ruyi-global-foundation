---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-ruyi-100 rounded-2xl border border-ruyi-100 bg-white">
  {
    items.map((item) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ruyi-900 [&::-webkit-details-marker]:hidden">
          {item.q}
          <span aria-hidden="true" class="text-xl text-gold-600 transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-ink/80">{item.a}</p>
      </details>
    ))
  }
</div>
