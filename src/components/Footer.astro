---
import { site } from '../data/site';
import { localizePath, useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useContent(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ruyi-900 text-white/90">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="font-serif text-xl font-bold text-gold-300">如意基金會</p>
      <p class="text-sm">{site.legalName}</p>
      <p class="mt-3 text-sm italic text-white/80">{c.footer.tagline}</p>
    </div>
    <div class="text-sm leading-relaxed">
      <p>{c.footer.status}</p>
      <p>{c.footer.ein}: {site.ein}</p>
      <p class="mt-3"><span class="text-white/70">{c.footer.principalOffice}:</span><br />{site.principalOffice}</p>
      <p class="mt-2"><span class="text-white/70">{c.footer.mailingAddress}:</span><br />{site.mailingAddress}</p>
    </div>
    <div class="flex flex-col gap-2 text-sm">
      <a href={localizePath(lang, '/about')} class="hover:text-gold-300">{c.nav.about}</a>
      <a href={localizePath(lang, '/programs')} class="hover:text-gold-300">{c.nav.programs}</a>
      <a href={localizePath(lang, '/get-involved')} class="hover:text-gold-300">{c.nav.getInvolved}</a>
      <a href={localizePath(lang, '/donate')} class="hover:text-gold-300">{c.nav.donate}</a>
      <a href={localizePath(lang, '/contact')} class="hover:text-gold-300">{c.nav.contact}</a>
      <a href={localizePath(lang, '/privacy')} class="hover:text-gold-300">{c.footer.privacy}</a>
      <a href={`mailto:${site.email}`} class="hover:text-gold-300">{site.email}</a>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-white/70">
    © {year} {site.legalName}. {c.footer.rights}
  </div>
</footer>
