---
import { formatUSD, plans } from '../data/pricing';
import { useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = useContent(lang).network.pricing;
const groups = [
  { label: p.individual, items: plans.filter((x) => x.audience === 'individual') },
  { label: p.organization, items: plans.filter((x) => x.audience === 'organization') },
];
---

<div class="grid gap-8 md:grid-cols-2">
  {
    groups.map((g) => (
      <div>
        <h3 class="mb-3 text-lg font-semibold text-jade-700">{g.label}</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          {g.items.map((plan) => (
            <div class="card flex flex-col">
              <p class="font-semibold text-ruyi-900">{p.plans[plan.key].name}</p>
              <p class="mt-2">
                <span class="text-3xl font-bold text-ruyi-700">{formatUSD(plan.price)}</span>
                <span class="text-sm text-ink/70"> / {p.plans[plan.key].period}</span>
              </p>
              <p class="mt-3 text-sm text-ink/80">{p.plans[plan.key].includes}</p>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
<p class="mt-6 rounded-xl bg-gold-300/30 p-4 text-sm text-ink/80">{p.note}</p>
