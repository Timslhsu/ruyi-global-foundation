---
interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<section class="bg-ruyi-800 text-white">
  <div class="container-page flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 class="font-serif text-3xl font-bold">{title}</h2>
      {text && <p class="mt-3 text-white/85">{text}</p>}
    </div>
    <div class="flex flex-wrap gap-3"><slot /></div>
  </div>
</section>
