---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CheckList from '../components/CheckList.astro';
import EnrollButton from '../components/EnrollButton.astro';
import MailtoForm from '../components/MailtoForm.astro';
import { formHref } from '../data/site';
import { mentorFields } from '../data/forms';
import { useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const g = useContent(lang).getInvolved;
const anchors = [
  { id: 'mentees', label: g.mentees.title },
  { id: 'mentors', label: g.mentors.title },
  { id: 'organizations', label: g.organizations.title },
];
---

<BaseLayout lang={lang} title={g.title} description={g.description}>
  <PageHero title={g.hero.title} subtitle={g.hero.subtitle}>
    <div class="mt-8 flex flex-wrap gap-3">
      {anchors.map((a) => <a href={`#${a.id}`} class="btn-outline py-2!">{a.label}</a>)}
    </div>
  </PageHero>

  <section id="mentees" class="section scroll-mt-20">
    <div class="container-page">
      <p class="eyebrow">{g.mentees.subtitle}</p>
      <h2 class="h2 mt-2">{g.mentees.title}</h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        <div class="card">
          <h3 class="font-semibold text-jade-700">{g.mentees.whoTitle}</h3>
          <CheckList items={g.mentees.who} class="mt-3 text-sm" />
        </div>
        <div id="scholarship" class="card scroll-mt-20">
          <h3 class="font-semibold text-jade-700">{g.mentees.scholarshipTitle}</h3>
          <CheckList items={g.mentees.scholarship} class="mt-3 text-sm" />
        </div>
        <div class="card">
          <h3 class="font-semibold text-jade-700">{g.mentees.docsTitle}</h3>
          <CheckList items={g.mentees.docs} class="mt-3 text-sm" />
          <p class="mt-4 text-sm text-ink/70">{g.mentees.privacyNote}</p>
        </div>
      </div>
      <EnrollButton lang={lang} href={formHref('mentee', 'Participant application')} label={g.mentees.cta} class="mt-8" />
    </div>
  </section>

  <section id="mentors" class="section scroll-mt-20 bg-white">
    <div class="container-page">
      <p class="eyebrow">{g.mentors.subtitle}</p>
      <h2 class="h2 mt-2">{g.mentors.title}</h2>
      <p class="mt-3 font-serif text-xl text-ruyi-700">“{g.mentors.message}”</p>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="card">
          <h3 class="font-semibold text-jade-700">{g.mentors.qualTitle}</h3>
          <CheckList items={g.mentors.qualifications} class="mt-3 text-sm" />
        </div>
        <div class="card">
          <h3 class="font-semibold text-jade-700">{g.mentors.trainingTitle}</h3>
          <CheckList items={g.mentors.training} class="mt-3 text-sm" />
        </div>
      </div>
      <div class="mt-6">
        <h3 class="font-semibold text-jade-700">{g.mentors.experienceTitle}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {g.mentors.experiences.map((e) => <li class="rounded-full bg-ruyi-50 px-3 py-1 text-sm text-ruyi-800">{e}</li>)}
        </ul>
      </div>
      <p class="mt-6 text-ink/80">{g.mentors.commitment}</p>
      <div class="mt-6">
        <MailtoForm
          id="mentor-form"
          lang={lang}
          buttonLabel={g.mentors.cta}
          title={g.mentors.form.title}
          intro={g.mentors.form.intro}
          subject="Mentor application"
          fields={mentorFields(lang)}
          submitLabel={g.mentors.form.submit}
        />
      </div>
    </div>
  </section>

  <section id="organizations" class="section scroll-mt-20">
    <div class="container-page">
      <p class="eyebrow">{g.organizations.subtitle}</p>
      <h2 class="h2 mt-2">{g.organizations.title}</h2>
      <p class="lead mt-4 max-w-3xl">{g.organizations.text}</p>
      <h3 class="mt-8 font-semibold text-jade-700">{g.organizations.waysTitle}</h3>
      <div class="mt-4 grid gap-6 md:grid-cols-3">
        {
          g.organizations.ways.map((w) => (
            <div class="card">
              <h4 class="font-semibold text-ruyi-900">{w.title}</h4>
              <p class="mt-2 text-sm text-ink/80">{w.text}</p>
            </div>
          ))
        }
      </div>
      <a href={formHref('organization', 'Organization partnership inquiry')} class="btn-primary mt-8">{g.organizations.cta}</a>
    </div>
  </section>
</BaseLayout>
