---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useContent(lang);
const p = c.privacy;
---

<BaseLayout lang={lang} title={p.title} description={p.description}>
  <PageHero title={p.title} subtitle={p.effective} />
  <section class="section">
    <div class="container-page max-w-3xl space-y-8">
      {
        p.sections.map((s) => (
          <div>
            <h2 class="text-xl font-semibold text-ruyi-900">{s.title}</h2>
            {s.body.map((para) => <p class="mt-2 leading-relaxed text-ink/85">{para}</p>)}
          </div>
        ))
      }
      <p class="border-t border-ruyi-100 pt-6 text-sm text-ink/70">
        {site.legalName} · {site.mailingAddress} · <a href={`mailto:${site.email}`} class="text-jade-700 underline">{site.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
