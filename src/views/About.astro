---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CheckList from '../components/CheckList.astro';
import { board } from '../data/board';
import { site } from '../data/site';
import { useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = useContent(lang).about;
---

<BaseLayout lang={lang} title={a.title} description={a.description}>
  <PageHero title={a.hero.title} subtitle={a.hero.subtitle} />

  <section class="section">
    <div class="container-page grid gap-6 md:grid-cols-2">
      {
        [a.mission, a.vision].map((block) => (
          <div class="card border-l-4 border-l-gold-400">
            <h2 class="eyebrow">{block.title}</h2>
            <p class="mt-3 font-serif text-xl leading-relaxed text-ruyi-900">{block.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page">
      <h2 class="h2">{a.values.title}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          a.values.items.map((v) => (
            <div>
              <h3 class="font-semibold text-ruyi-800">{v.title}</h3>
              <p class="mt-1 text-sm text-ink/80">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="h2">{a.purposes.title}</h2>
        <p class="mt-4 text-ink/80">{a.purposes.intro}</p>
        <CheckList items={a.purposes.points} class="mt-4" />
      </div>
      <div>
        <h2 class="h2">{a.history.title}</h2>
        <ol class="mt-6 border-l-2 border-gold-400">
          {
            a.history.items.map((item) => (
              <li class="relative mb-6 pl-6">
                <span aria-hidden="true" class="absolute top-1.5 -left-[7px] h-3 w-3 rounded-full bg-ruyi-700"></span>
                <p class="text-sm font-semibold text-jade-700">{item.date}</p>
                <p class="text-ink/85">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {
    site.features.showBoard && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="h2">{a.board.title}</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {
            board.map((m) => (
              <li class="card text-center">
                <div aria-hidden="true" class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-ruyi-50 font-serif text-2xl text-ruyi-700">
                  {m.name.charAt(0)}
                </div>
                <p class="mt-3 font-semibold text-ruyi-900">{m.name}</p>
                {m.nameZh && <p class="text-sm text-ink/70">{m.nameZh}</p>}
                <p class="mt-1 text-sm text-jade-700">{a.board.roles[m.role]}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    )
  }

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="h2">{a.governance.title}</h2>
        <CheckList items={a.governance.points} class="mt-6" />
      </div>
      <div>
        <h2 class="h2">{a.legal.title}</h2>
        <dl class="mt-6 divide-y divide-ruyi-100 rounded-2xl border border-ruyi-100 bg-white">
          {
            a.legal.rows.map((r) => (
              <div class="grid gap-1 p-4 sm:grid-cols-3">
                <dt class="text-sm font-semibold text-ink/70">{r.label}</dt>
                <dd class="sm:col-span-2">{r.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
