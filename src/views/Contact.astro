---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MailtoForm from '../components/MailtoForm.astro';
import { contactFields } from '../data/forms';
import { useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const k = useContent(lang).contact;
---

<BaseLayout lang={lang} title={k.title} description={k.description}>
  <PageHero title={k.hero.title} subtitle={k.hero.subtitle} />
  <section class="section">
    <div class="container-page max-w-xl">
      <div class="card">
        <h2 class="text-xl font-semibold text-ruyi-900">{k.formTitle}</h2>
        <p class="mt-2 text-ink/80">{k.formText}</p>
        <div class="mt-5">
          <MailtoForm
            id="contact-form"
            lang={lang}
            buttonLabel={k.formCta}
            title={k.form.title}
            subject="Website inquiry"
            fields={contactFields(lang)}
            submitLabel={k.form.submit}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
