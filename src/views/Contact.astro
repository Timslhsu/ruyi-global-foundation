---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { formHref, site } from '../data/site';
import { useContent, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const k = useContent(lang).contact;
const blocks = [
  { title: k.mailTitle, value: site.mailingAddress },
  { title: k.officeTitle, value: site.principalOffice },
];
---

<BaseLayout lang={lang} title={k.title} description={k.description}>
  <PageHero title={k.hero.title} subtitle={k.hero.subtitle} />
  <section class="section">
    <div class="container-page grid gap-6 md:grid-cols-3">
      <div class="card">
        <h2 class="font-semibold text-jade-700">{k.emailTitle}</h2>
        <a href={`mailto:${site.email}`} class="mt-2 block font-semibold break-all text-ruyi-800 hover:underline">{site.email}</a>
        <a href={formHref('contact', 'Website inquiry')} class="btn-primary mt-5">{k.formCta}</a>
      </div>
      {
        blocks.map((b) => (
          <div class="card">
            <h2 class="font-semibold text-jade-700">{b.title}</h2>
            <p class="mt-2">{b.value}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
